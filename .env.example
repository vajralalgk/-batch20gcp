# ============================================================================
# Enterprise Cloud Transformation Platform (ECTP) - Environment Configuration
# Author: Gopi Krishna Vajrala
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# ============================================================================

# --- Application Settings ---
ECTP_ENV=development
ECTP_APP_NAME=ECTP
ECTP_APP_VERSION=1.0.0
ECTP_DEBUG=true
ECTP_LOG_LEVEL=DEBUG
ECTP_HOST=0.0.0.0
ECTP_PORT=8000

# --- Database Settings ---
ECTP_DB_HOST=localhost
ECTP_DB_PORT=5432
ECTP_DB_NAME=ectp_dev
ECTP_DB_USER=ectp_user
ECTP_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
ECTP_DB_POOL_SIZE=10
ECTP_DB_MAX_OVERFLOW=20

# --- Redis Settings ---
ECTP_REDIS_HOST=localhost
ECTP_REDIS_PORT=6379
ECTP_REDIS_DB=0
ECTP_REDIS_PASSWORD=

# --- AWS Settings ---
AWS_REGION=us-east-1
AWS_PROFILE=ectp-dev
AWS_ACCOUNT_ID=123456789012

# --- ServiceNow Integration ---
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=your-client-id
SERVICENOW_CLIENT_SECRET=CHANGE_ME
SERVICENOW_USERNAME=api-user
SERVICENOW_PASSWORD=CHANGE_ME

# --- Ellucian Integration ---
ELLUCIAN_ETHOS_API_URL=https://integrate.elluciancloud.com
ELLUCIAN_API_KEY=CHANGE_ME
ELLUCIAN_TENANT_ID=your-tenant-id

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS Settings ---
ECTP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
