# ============================================================================
# Netflix Real-Time LLM Personalization & Inference Platform
# Environment Configuration
# Author: Gopi Krishna Vajrala
# ============================================================================

# --- Application ---
APP_NAME=netflix-llm-platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- GPU Configuration ---
ENABLE_GPU=false
GPU_DEVICE_IDS=0,1,2,3
TENSOR_PARALLEL_SIZE=4
GPU_MEMORY_FRACTION=0.9
MAX_BATCH_SIZE=64
DYNAMIC_BATCHING_ENABLED=true
DYNAMIC_BATCH_TIMEOUT_MS=5

# --- Triton Inference Server ---
TRITON_SERVER_URL=localhost:8001
TRITON_MODEL_NAME=llm-reranker-13b
TRITON_MODEL_VERSION=1
TRITON_MAX_QUEUE_DELAY_MS=100

# --- Model Configuration ---
MODEL_NAME=meta-llama/Llama-2-13b-hf
MODEL_QUANTIZATION=int8
MAX_SEQUENCE_LENGTH=2048
KV_CACHE_MAX_TOKENS=100000
KV_CACHE_TTL_SECONDS=300

# --- Redis (Session Memory) ---
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ENABLED=false
REDIS_MAX_CONNECTIONS=100
SESSION_TTL_SECONDS=1800

# --- AWS Configuration ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# --- DynamoDB (Feature Store) ---
DYNAMODB_TABLE_USER_EMBEDDINGS=user-embeddings
DYNAMODB_TABLE_CONTENT_EMBEDDINGS=content-embeddings
DYNAMODB_TABLE_FEATURES=realtime-features

# --- S3 (Model Artifacts) ---
S3_MODEL_BUCKET=netflix-llm-models
S3_MODEL_PREFIX=models/

# --- Observability ---
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
DCGM_EXPORTER_ENABLED=true
DCGM_EXPORTER_PORT=9400
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
GRAFANA_URL=http://localhost:3000

# --- Multi-Region ---
PRIMARY_REGION=us-east-1
SECONDARY_REGIONS=us-west-2,eu-west-1
CROSS_REGION_REPLICATION=true
FAILOVER_TIMEOUT_SECONDS=15

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_SECOND=10000
RATE_LIMIT_BURST_SIZE=15000

# --- Security ---
JWT_SECRET_KEY=your-jwt-secret
JWT_ALGORITHM=HS256
ENCRYPTION_KEY_ID=alias/netflix-llm-kms
MTLS_ENABLED=false
