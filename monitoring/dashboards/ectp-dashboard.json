            },
            "width": 8,
            "height": 6
        },
        {
            "type": "metric",
            "properties": {
                "title": "SQS Queue Depth",
                "metrics": [
                    ["AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "ectp-tasks", {"stat": "Average", "period": 300}]
                ],
                "view": "timeSeries",
                "region": "us-east-1",
                "period": 300
            },
            "width": 8,
            "height": 6
        },
        {
            "type": "metric",
            "properties": {
                "title": "Monthly Cost Trend",
                "metrics": [
                    ["ECTP", "MonthlyCost", "Account", "Production", {"stat": "Maximum", "period": 86400}]
